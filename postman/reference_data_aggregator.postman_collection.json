    {
      "name": "Validation & Error Cases",
      "description": "API responses illustrating error patterns, structured in compliance with RFC 9457 `application/problem+json`.",
      "item": [
        {
          "name": "Country Not Found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/countries/ZZ",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "countries",
                "ZZ"
              ]
            },
            "description": "Demonstrates error payload format when attempting to retrieve a country with a valid code format but that does not exist in the reference database."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Returns RFC 9457 problem JSON\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\", \"application/problem+json\");",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.equal(404);",
                  "    pm.expect(jsonData.title).to.equal(\"Country Not Found\");",
                  "    pm.expect(jsonData.detail).to.include(\"not found\");",
                  "    pm.expect(jsonData).to.have.property(\"timestamp\");",
                  "    pm.expect(jsonData).to.have.property(\"instance\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Invalid ISO Code Parameter (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/countries/KEN",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "countries",
                "KEN"
              ]
            },
            "description": "Demonstrates input validation constraint mapping. Country ISO codes must be exactly 2 characters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Returns validation error problem JSON\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\", \"application/problem+json\");",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.equal(400);",
                  "    pm.expect(jsonData.title).to.equal(\"Invalid Request Parameter\");",
                  "    pm.expect(jsonData.detail).to.include(\"isoCode must be exactly 2 letters\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Invalid SortBy Parameter (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/countries?sortBy=invalid",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "countries"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "invalid"
                }
              ]
            },
            "description": "Demonstrates validation constraint mapping for query parameters. `sortBy` must be one of: name, isoCode, capital, phoneCode, continentCode, currencyCode."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Returns validation error problem JSON\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\", \"application/problem+json\");",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.equal(400);",
                  "    pm.expect(jsonData.title).to.equal(\"Invalid Request Parameter\");",
                  "    pm.expect(jsonData.detail).to.include(\"sortBy must be one of\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
