{
  "info": {
    "_postman_id": "55afc948-492e-4b91-ba6d-9bfe5f3d6806",
    "name": "Reference Data Aggregation Service (RDAS)",
    "description": "Postman Collection for Reference Data Aggregation Service (RDAS).\n\nThis collection maps all the endpoints of the Reference Data Aggregation Service, including pagination, filtering, conditional requests with ETags, health checks, metrics, and error handling verification. All request paths are dynamic and use the `{{baseUrl}}` variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Reference Data",
      "description": "Endpoints to query countries, currencies, continents, and languages.",
      "item": [
        {
          "name": "Countries",
          "description": "Endpoints relating to country reference data, supporting searching, sorting, pagination, and ETag-based conditional caching.",
          "item": [
            {
              "name": "List Countries (Paginated & Sorted)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/countries?page=0&size=20&sortBy=name&sortDir=asc",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "countries"
                  ],
                  "query": [
                    {
                      "key": "page",
                      "value": "0",
                      "description": "Page number (0-indexed)"
                    },
                    {
                      "key": "size",
                      "value": "20",
                      "description": "Page size (1-100)"
                    },
                    {
                      "key": "sortBy",
                      "value": "name",
                      "description": "Field to sort by (name, isoCode, capital, phoneCode, continentCode, currencyCode)"
                    },
                    {
                      "key": "sortDir",
                      "value": "asc",
                      "description": "Sort direction (asc, desc)"
                    }
                  ]
                },
                "description": "Retrieves a paginated list of countries. Results are enveloped with metadata including the data timestamp (`dataAsOf`) and staleness indicator (`stale`)."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Response is in enveloped format\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.have.property(\"dataAsOf\");",
                      "    pm.expect(jsonData).to.have.property(\"stale\");",
                      "    pm.expect(jsonData).to.have.property(\"data\");",
                      "    pm.expect(jsonData.data).to.have.property(\"content\");",
                      "    pm.expect(jsonData.data.content).to.be.an(\"array\");",
                      "});",
                      "",
                      "pm.test(\"Verify ETag header is present\", function () {",
                      "    pm.response.to.have.header(\"ETag\");",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Search Countries by Name",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/countries?name=Kenya",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "countries"
                  ],
                  "query": [
                    {
                      "key": "name",
                      "value": "Kenya",
                      "description": "Partial or exact matching name (case-insensitive)"
                    }
                  ]
                },
                "description": "Searches for countries by name."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Search results contain matches\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData.data.content.length).to.be.above(0);",
                      "    pm.expect(jsonData.data.content[0].name.toLowerCase()).to.include(\"kenya\");",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Filter Countries by Continent",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/countries?continent=AF",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "countries"
                  ],
                  "query": [
                    {
                      "key": "continent",
                      "value": "AF",
                      "description": "Continent code (e.g. AF, EU, AS, NA, SA, OC, AN)"
                    }
                  ]
                },
                "description": "Filters countries to only show those belonging to the specified continent."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Filtered results match continent code\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    jsonData.data.content.forEach(country => {",
                      "        pm.expect(country.continent.code).to.equal(\"AF\");",
                      "    });",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
