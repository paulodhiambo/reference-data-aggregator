                      "    });",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Get Country by ISO Code",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/countries/KE",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "countries",
                    "KE"
                  ]
                },
                "description": "Retrieves the full details for a single country by its 2-letter ISO code. Saves the response ETag to a collection variable (`last_etag`) for subsequent caching tests."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Country details match request\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData.data.isoCode).to.equal(\"KE\");",
                      "    pm.expect(jsonData.data.name).to.equal(\"Kenya\");",
                      "});",
                      "",
                      "// Extract ETag and store as collection variable",
                      "const etag = pm.response.headers.get(\"ETag\");",
                      "if (etag) {",
                      "    pm.collectionVariables.set(\"last_etag\", etag);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Get Country by ISO Code (Conditional - ETag)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "If-None-Match",
                    "value": "{{last_etag}}",
                    "description": "ETag of the cached resource",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/countries/KE",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "countries",
                    "KE"
                  ]
                },
                "description": "Tests ETag conditional requests. Uses the `If-None-Match` header to send the ETag stored in the `last_etag` collection variable. If the cached version is still fresh, the server returns 304 Not Modified."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 304 Not Modified\", function () {",
                      "    pm.response.to.have.status(304);",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            }
          ]
        },
