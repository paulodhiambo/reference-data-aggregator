                  }
                }
              ]
            },
            {
              "name": "Filter Countries by Language",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/countries?language=swa",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "countries"
                  ],
                  "query": [
                    {
                      "key": "language",
                      "value": "swa",
                      "description": "3-letter language ISO code (case-insensitive)"
                    }
                  ]
                },
                "description": "Filters countries to only show those that speak the specified language."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Filtered results speak the language\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    jsonData.data.content.forEach(country => {",
                      "        const codes = country.languages.map(l => l.code.toLowerCase());",
